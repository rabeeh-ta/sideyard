# /etc/sideyard/sideyard.env (install.sh writes it). Restart after changes:
#   sudo systemctl restart sideyard
# Base domain. Projects get <name>.<domain>; the dashboard is sideyard.<domain>.
SIDEYARD_DOMAIN=example.com
# Let's Encrypt account email (optional).
SIDEYARD_ACME_EMAIL=you@example.com
# This server's public IPv4, for the dashboard's DNS checks behind NAT.
SIDEYARD_PUBLIC_IP=
# Serve the dashboard somewhere other than sideyard.<domain>:
# SIDEYARD_DASHBOARD_HOST=deploy.example.com
# Look for releases elsewhere (a fork's repository URL), or turn checks off:
# SIDEYARD_UPDATE_SOURCE=off
